<Window
    x:Class="PdfNote.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="#FF202020">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ツールバー (F10 で表示切替) -->
        <Grid x:Name="ToolbarGrid" Grid.Row="0"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Padding="8,6"
              ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="OpenButton" Grid.Column="0" Click="OnOpenClick"
                    ToolTipService.ToolTip="PDF を開く (Ctrl+O)">
                <FontIcon Glyph="&#xE8E5;" />
            </Button>
            <Button x:Name="PrevButton" Grid.Column="1" Click="OnPrevPageClick"
                    ToolTipService.ToolTip="前のページ (PageUp)">
                <FontIcon Glyph="&#xE72B;" />
            </Button>
            <Button x:Name="NextButton" Grid.Column="2" Click="OnNextPageClick"
                    ToolTipService.ToolTip="次のページ (PageDown)">
                <FontIcon Glyph="&#xE72A;" />
            </Button>
            <TextBlock x:Name="PageText" Grid.Column="3" VerticalAlignment="Center"
                       FontSize="13" MinWidth="80" TextAlignment="Center" Text="-" />
            <Border Grid.Column="4" />
            <Button x:Name="ZoomOutButton" Grid.Column="5" Click="OnZoomOutClick"
                    ToolTipService.ToolTip="縮小 (-)">
                <FontIcon Glyph="&#xE71F;" />
            </Button>
            <TextBlock x:Name="ZoomText" Grid.Column="6" VerticalAlignment="Center"
                       FontSize="13" MinWidth="52" TextAlignment="Center" Text="100%" />
            <Button x:Name="ZoomInButton" Grid.Column="7" Click="OnZoomInClick"
                    ToolTipService.ToolTip="拡大 (+)">
                <FontIcon Glyph="&#xE8A3;" />
            </Button>
            <ToggleButton x:Name="FpsToggle" Grid.Column="8" Click="OnFpsToggleClick"
                          ToolTipService.ToolTip="FPSオーバーレイ (F9)" Content="FPS" />
        </Grid>

        <!-- PDF 表示領域 (PdfCanvas はコードビハインドで追加) -->
        <Grid x:Name="ContentHost" Grid.Row="1">
            <TextBlock x:Name="PerfText"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,8,8"
                       FontFamily="Consolas" FontSize="12"
                       Foreground="#CC9CDCFF"
                       IsHitTestVisible="False"
                       Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
