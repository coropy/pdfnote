<Window
    x:Class="PdfNote.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:home="using:PdfNote.Home">

    <Grid x:Name="RootGrid" Background="#FF202020">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ツールバー (F10 で表示切替) -->
        <Grid x:Name="ToolbarGrid" Grid.Row="0"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Padding="8,6"
              ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="OpenButton" Grid.Column="0" Click="OnOpenClick"
                    ToolTipService.ToolTip="PDF を開く (Ctrl+O)">
                <FontIcon Glyph="&#xE8E5;" />
            </Button>
            <Button x:Name="NewBlankNotebookButton" Grid.Column="1" Click="OnNewBlankNotebookClick"
                    ToolTipService.ToolTip="白紙ノートを新規作成 (A4 縦 × 10 ページ)">
                <FontIcon Glyph="&#xE7C3;" />
            </Button>
            <ToggleButton x:Name="BackgroundToggleButton" Grid.Column="2" Click="OnToggleBackgroundClick"
                          ToolTipService.ToolTip="現在ページの背景切替 (白紙 / 方眼)">
                <FontIcon Glyph="&#xE71D;" />
            </ToggleButton>
            <Button x:Name="PrevButton" Grid.Column="3" Click="OnPrevPageClick"
                    ToolTipService.ToolTip="前のページ (PageUp)">
                <FontIcon Glyph="&#xE72B;" />
            </Button>
            <Button x:Name="NextButton" Grid.Column="4" Click="OnNextPageClick"
                    ToolTipService.ToolTip="次のページ (PageDown)">
                <FontIcon Glyph="&#xE72A;" />
            </Button>
            <TextBlock x:Name="PageText" Grid.Column="5" VerticalAlignment="Center"
                       FontSize="13" MinWidth="80" TextAlignment="Center" Text="-" />
            <Border Grid.Column="6" />
            <ToggleButton x:Name="PenToolButton" Grid.Column="7" Click="OnPenToolClick"
                          ToolTipService.ToolTip="ペン (筆圧対応)">
                <FontIcon Glyph="&#xEDFB;" />
            </ToggleButton>
            <ToggleButton x:Name="EraserToolButton" Grid.Column="8" Click="OnEraserToolClick"
                          ToolTipService.ToolTip="消しゴム (Stroke単位 / ペン裏ボタンでTemporaryEraser)">
                <FontIcon Glyph="&#xED60;" />
            </ToggleButton>
            <Button x:Name="UndoButton" Grid.Column="9" Click="OnUndoClick"
                    ToolTipService.ToolTip="元に戻す (Ctrl+Z)">
                <FontIcon Glyph="&#xE7A7;" />
            </Button>
            <Button x:Name="RedoButton" Grid.Column="10" Click="OnRedoClick"
                    ToolTipService.ToolTip="やり直し (Ctrl+Y)">
                <FontIcon Glyph="&#xE7A6;" />
            </Button>
            <Button x:Name="ZoomOutButton" Grid.Column="11" Click="OnZoomOutClick"
                    ToolTipService.ToolTip="縮小 (-)">
                <FontIcon Glyph="&#xE71F;" />
            </Button>
            <TextBlock x:Name="ZoomText" Grid.Column="12" VerticalAlignment="Center"
                       FontSize="13" MinWidth="52" TextAlignment="Center" Text="100%" />
            <Button x:Name="ZoomInButton" Grid.Column="13" Click="OnZoomInClick"
                    ToolTipService.ToolTip="拡大 (+)">
                <FontIcon Glyph="&#xE8A3;" />
            </Button>
            <ToggleButton x:Name="FpsToggle" Grid.Column="14" Click="OnFpsToggleClick"
                          ToolTipService.ToolTip="FPSオーバーレイ (F9)" Content="FPS" />
            <TextBlock x:Name="SaveStatusText" Grid.Column="15" VerticalAlignment="Center"
                       FontSize="12" MinWidth="64" TextAlignment="Center" Text="" />
            <Button x:Name="SettingsButton" Grid.Column="16" Click="OnSettingsClick"
                    ToolTipService.ToolTip="設定 (ペンボタン / ショートカット)">
                <FontIcon Glyph="&#xE713;" />
            </Button>
            <Button x:Name="HomeButton" Grid.Column="17" Click="OnHomeClick"
                    ToolTipService.ToolTip="ホーム (ノートブック一覧)">
                <FontIcon Glyph="&#xE80F;" />
            </Button>
            <ToggleButton x:Name="SelectToolButton" Grid.Column="18" Click="OnSelectToolClick"
                          ToolTipService.ToolTip="選択ツール (PDFオブジェクトの選択 / 移動 / リサイズ)" Content="選択" />
            <Button x:Name="RotateSelectedButton" Grid.Column="19" Click="OnRotateSelectedClick"
                    ToolTipService.ToolTip="選択中オブジェクトを90°回転" Content="回転" />
            <Button x:Name="BringFrontButton" Grid.Column="20" Click="OnBringFrontClick"
                    ToolTipService.ToolTip="選択中オブジェクトを最前面へ" Content="前へ" />
            <Button x:Name="SendBackButton" Grid.Column="21" Click="OnSendBackClick"
                    ToolTipService.ToolTip="選択中オブジェクトを最背面へ" Content="後ろへ" />
            <Button x:Name="AddPdfButton" Grid.Column="22" Click="OnAddPdfClick"
                    ToolTipService.ToolTip="PDFファイルを選んで現在のページへ配置" Content="PDF配置" />
        </Grid>

        <!-- PDF 表示領域 (PdfCanvas はコードビハインドで追加。HomeView は最前面に重ねる) -->
        <Grid x:Name="ContentHost" Grid.Row="1">
            <TextBlock x:Name="PerfText"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,8,8"
                       FontFamily="Consolas" FontSize="12"
                       Foreground="#CC9CDCFF"
                       IsHitTestVisible="False"
                       Visibility="Collapsed" />
            <home:HomeView x:Name="HomeViewElement" Visibility="Visible" />
        </Grid>
    </Grid>
</Window>
