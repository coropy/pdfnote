<UserControl
    x:Class="PdfNote.Home.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:home="using:PdfNote.Home">

    <Grid Background="#FF202020" Padding="48,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="ノートブック" FontSize="28" FontWeight="SemiBold" />
            <Button x:Name="CreateButton" Grid.Column="1" Click="OnCreateClick" Content="新規作成"
                    ToolTipService.ToolTip="白紙ノート (A4 / 10ページ) を作成" />
        </Grid>

        <!-- ノートアイコン (横4列 / 5個目以降は下の行へ折り返し)。クリックで開く、右クリックで操作メニュー。
             スクロールバーは非表示 (ホイール / ドラッグでスクロール可)。グリッド全体は中央配置で左右対称。 -->
        <GridView x:Name="NotebookGrid" Grid.Row="2" Margin="0,20,0,0"
                  MaxWidth="1240" HorizontalAlignment="Center"
                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                  SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnItemClicked">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal"
                                   MaximumRowsOrColumns="4"
                                   ItemWidth="310" ItemHeight="400" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="home:NotebookIconItem">
                    <StackPanel Width="240" Spacing="10" Tag="{x:Bind}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="開く" Tag="{x:Bind}" Click="OnMenuOpenClick" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="名前変更" Tag="{x:Bind}" Click="OnMenuRenameClick" />
                                <MenuFlyoutItem Text="削除" Tag="{x:Bind}" Click="OnMenuDeleteClick" />
                            </MenuFlyout>
                        </StackPanel.ContextFlyout>

                        <!-- 1 ページ目サムネイル (手書き無しの白紙は純白のまま)。
                             ほぼ正方形の領域にどんな比率のページも Uniform で収める。 -->
                        <Border CornerRadius="6" BorderBrush="#55FFFFFF" BorderThickness="1"
                                Background="White" Height="290" Width="240">
                            <Grid>
                                <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                                <TextBlock Text="破損" FontSize="18" FontWeight="SemiBold"
                                           Foreground="#FFB0B0B0"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{x:Bind BrokenVisibility, Mode=OneWay}" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{x:Bind Name}" FontSize="15"
                                   TextTrimming="CharacterEllipsis" MaxLines="1"
                                   HorizontalAlignment="Left" />
                        <TextBlock Text="{x:Bind UpdatedText}" FontSize="11"
                                   Foreground="#CCB0B0B0" HorizontalAlignment="Left" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</UserControl>

